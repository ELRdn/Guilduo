{
  "productName": "QuestForge",
  "appVersion": "0.5.0-beta.1",
  "integrationType": "remote-mcp-app",
  "technicalAppId": "",
  "mcpEndpoint": "https://your-questforge-worker.example.workers.dev/mcp",
  "oauthMetadata": "https://your-questforge-worker.example.workers.dev/.well-known/oauth-authorization-server",
  "scopes": ["quests:read", "quests:write", "character:read", "events:read"],
