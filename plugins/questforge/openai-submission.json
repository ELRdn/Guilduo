  "dataPolicy": {
    "questTextSentToProvider": true,
    "publicByDefault": false,
    "telemetryOptInOnly": true,
    "accountDeletionDocument": "PRIVACY.md"
  },
  "submissionState": "operator_submits_after_public-beta-acceptance"
}
