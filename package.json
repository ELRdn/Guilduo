{
  "name": "guilduo",
  "version": "0.6.0-beta.8",
  "description": "Human and AI work platform for coordinating Quests, handoffs, evidence, and decisions.",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "brand:assets": "tsx tools/generate-brand-assets.mts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck",
    "deploy": "npm run build",
    "worker:dev": "wrangler dev --port 8787",
    "worker:deploy": "wrangler deploy",
    "mcp:local": "tsx mcp-local/questforge-mcp.ts",
    "api:generate": "tsx tools/update-api-contracts.mts",
    "design:check": "tsx tools/check-design-system.mts",
    "design:capture": "tsx tools/capture-design-references.mts",
    "tokens:generate": "tsx tools/generate-tokens.mts",
    "tokens:check": "tsx tools/generate-tokens.mts --check",
    "visual:lock": "tsx tools/lock-v3-references.mts",
    "visual:capture": "tsx tools/visual-regression.mts capture",
    "visual:diff": "tsx tools/visual-regression.mts diff",
    "visual:check": "tsx tools/visual-regression.mts check",
    "visual:matrix": "tsx tools/visual-regression.mts matrix",
    "lp:verify": "tsx tools/verify-lp.mts",
    "lp:capture": "tsx tools/capture-lp.mts",
    "cli": "tsx cli/questforge.ts",
    "generate-release-config": "tsx tools/generate-release-config.mts",
    "site:routing:check": "tsx --test tests/site-routing.test.ts",
    "migrate:appwrite": "tsx tools/migrate-firebase-to-appwrite.mts",
    "migrate:agent-owners": "tsx tools/migrate-agent-owners.mts",
    "revoke:legacy-mcp": "tsx tools/revoke-legacy-mcp-grants.mts",
    "typecheck": "npm run generate-types && wrangler types --check && npm run check:typescript-policy && tsc -b && npm run typecheck:battle",
    "check:typescript-policy": "tsx tools/check-typescript-policy.mts",
    "typecheck:battle": "tsc -p tsconfig.battle.json --noEmit",
    "typecheck:refresh": "npm run generate-types && tsc -b",
    "typecheck:watch": "tsc -b --watch",
    "generate-types": "wrangler types"
  },
  "bin": {
    "questforge": "cli/questforge.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "agents": "^0.20.1",
    "appwrite": "26.2.0",
    "intl-messageformat": "^11.2.13",
    "lucide": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "sharp": "0.35.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "4.116.0"
  },
  "engines": {
    "node": ">=22"
  }
}
