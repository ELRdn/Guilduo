{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Guilduo Design Tokens",
  "version": 1,
  "defaultTheme": "soft-ops",
  "defaultMode": "light",
  "semantic": {
    "human": "green",
    "agent": "blue",
    "rpg": "orange-gold",
    "danger": "red",
    "neutral": "gray-surface"
  },
  "themes": {
    "arcane": {
      "light": {
        "surface": "#FFF9F0",
        "canvas": "#ECEAE3",
        "human": "#4F8069",
        "agent": "#56757A",
        "rpg": "#A8792B",
        "danger": "#A24F58",
        "onSurface": "#1F272A",
        "line": "#D9E0E8"
      },
      "dark": {
        "surface": "#20262B",
        "canvas": "#15191D",
        "human": "#78B998",
        "agent": "#79AEB6",
        "rpg": "#D6AD5E",
        "danger": "#EF858B",
        "onSurface": "#F5F7F6",
        "line": "#3A474B"
      }
    },
    "soft-ops": {
      "light": {
        "surface": "#FFFFFF",
        "canvas": "#F3F2EF",
        "human": "#4F8A6D",
        "agent": "#4D7D8E",
        "rpg": "#B98535",
        "danger": "#C45D5D",
        "onSurface": "#1F272A",
        "line": "#D9E0E8"
      },
      "dark": {
        "surface": "#1E2830",
        "canvas": "#171F23",
        "human": "#78B493",
        "agent": "#69A8EF",
        "rpg": "#D2A75F",
        "danger": "#E98282",
        "onSurface": "#E2E7E5",
        "line": "#33424A"
      }
    },
    "retro": {
      "light": {
        "surface": "#FFF8E8",
        "canvas": "#EEE6D8",
        "human": "#4C8D42",
        "agent": "#315C78",
        "rpg": "#B16F20",
        "danger": "#C24732",
        "onSurface": "#1D211F",
        "line": "#CEC6B8"
      },
      "dark": {
        "surface": "#1D2130",
        "canvas": "#11131A",
        "human": "#82C36F",
        "agent": "#74A6C7",
        "rpg": "#E2B35E",
        "danger": "#F0765E",
        "onSurface": "#F8F4E7",
        "line": "#3B4151"
      }
    }
  },
  "typography": {
    "ui": "Inter, Noto Sans JP, Noto Sans KR, Noto Sans SC, Noto Sans TC, Segoe UI, system-ui, sans-serif",
    "data": "ui-monospace, SFMono-Regular, Cascadia Mono, JetBrains Mono, Consolas, monospace",
    "display": { "size": "32px", "weight": 700, "lineHeight": 1.15 },
    "heading": { "size": "22px", "weight": 700, "lineHeight": 1.25 },
    "body": { "size": "16px", "weight": 400, "lineHeight": 1.6 },
    "bodySmall": { "size": "14px", "weight": 400, "lineHeight": 1.5 },
    "label": { "size": "12px", "weight": 600, "lineHeight": 1.3 },
    "dataValue": { "size": "14px", "weight": 600, "lineHeight": 1.4 }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "gutter": "16px"
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "full": "9999px"
  },
  "motion": {
    "hover": "120ms",
    "panel": "180ms",
    "bottomSheet": "220ms",
    "easing": "ease-out",
    "retroEasing": "steps(2, end)"
  },
  "breakpoints": {
    "mobileMax": "900px",
    "tabletMin": "901px",
    "narrowDesktop": "1180px",
    "navCompact": "1060px"
  },
  "icons": {
    "library": "lucide",
    "stroke": 1.75,
    "navigation": "18px",
    "inline": "16px",
    "action": "18px",
    "emptyStateMax": "24px"
  }
}
