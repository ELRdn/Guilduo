{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "questforge-gateway",
	"main": "worker/src/index.ts",
	"compatibility_date": "2026-07-31",
	"compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "your-firebase-project-id",
    "FIREBASE_DATABASE_URL": "https://your-firebase-project-id-default-rtdb.REGION.firebasedatabase.app",
    "FIREBASE_API_KEY": "your-public-firebase-web-api-key",
    "FIREBASE_AUTH_DOMAIN": "your-firebase-project-id.firebaseapp.com",
    "PUBLIC_BASE_URL": "https://your-questforge-worker.example.workers.dev",
    "WEB_APP_URL": "https://your-firebase-project-id.web.app",
    "ALLOWED_ORIGINS": "https://your-firebase-project-id.web.app,http://localhost:5173,http://127.0.0.1:5173"
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    { "binding": "QUESTFORGE_DB", "database_name": "questforge-data", "database_id": "your-d1-database-id" }
  ],
  "kv_namespaces": [
    { "binding": "QUESTFORGE_KV", "id": "your-kv-namespace-id", "remote": true }
  ]
}
