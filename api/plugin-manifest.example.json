{
  "manifestVersion": "0.1",
  "id": "questforge-calendar-sync",
  "name": "Calendar Sync",
  "description": "Adds calendar import, due-date sync, and a side panel for today's quests.",
  "author": "Guilduo",
  "permissions": [
    "quests:read",
    "quests:write",
    "character:read",
    "integrations:read",
    "integrations:sync",
    "events:subscribe",
    "ui:mount"
  ],
  "events": [
    "quest.created",
    "quest.updated",
    "quest.scored",
    "quest.rolled_over",
    "integration.sync_completed",
    "integration.sync_failed"
  ],
  "uiSlots": [
    {
      "slot": "dashboard.sidecar",
      "entry": "https://example.invalid/questforge-plugin/sidecar.html"
    },
    {
      "slot": "quest.detail",
      "entry": "https://example.invalid/questforge-plugin/quest-detail-card.html"
    },
    {
      "slot": "integration.settings",
      "entry": "https://example.invalid/questforge-plugin/integration-settings.html"
    }
  ],
  "webhooks": [
    {
      "event": "quest.scored",
      "url": "https://example.invalid/webhooks/quest-scored"
    }
  ],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "calendarId": {
        "type": "string",
        "title": "Calendar ID"
      },
      "syncDirection": {
        "type": "string",
        "enum": ["import", "export", "both"],
        "default": "both"
      }
    }
  }
}
