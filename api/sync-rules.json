{
  "version": "0.1.0",
  "rules": [
    {
      "id": "calendar-event-to-time-block-quest",
      "service": "google-calendar",
      "direction": "import",
      "source": "calendar.event",
      "target": "quest",
      "mapping": {
        "summary": "title",
        "description": "notes",
        "start.dateTime": "timeBlock.start",
        "end.dateTime": "timeBlock.end",
        "recurrence": "repeat",
        "id": "externalLinks[].externalId"
      },
      "defaultQuest": {
        "kind": "todo",
        "difficulty": "medium",
        "tags": ["calendar"]
      }
    },
    {
      "id": "calendar-recurring-event-to-daily",
      "service": "google-calendar",
      "direction": "import",
      "source": "calendar.recurring_event",
      "target": "quest",
      "mapping": {
        "summary": "title",
        "start.date": "dueDate",
        "recurrence": "repeat"
      },
      "defaultQuest": {
        "kind": "daily",
        "difficulty": "easy",
        "tags": ["calendar", "routine"]
      }
    },
    {
      "id": "google-task-to-todo-quest",
      "service": "google-tasks",
      "direction": "bidirectional",
      "source": "tasks.task",
      "target": "quest",
      "mapping": {
        "title": "title",
        "notes": "notes",
        "due": "dueDate",
        "status": "done",
        "id": "externalLinks[].externalId"
      },
      "defaultQuest": {
        "kind": "todo",
        "difficulty": "medium",
        "tags": ["google-tasks"]
      },
      "limitations": [
        "Due time is not preserved because Google Tasks API stores date only."
      ]
    },
    {
      "id": "questforge-to-toggl-focus-task",
      "service": "toggl-focus",
      "direction": "export",
      "source": "questforge.quest",
      "target": "focus.task",
      "mapping": {
        "title": "name",
        "notes": "description,notes",
        "estimatedMinutes": "estimated_mins",
        "scheduledDate": "start_date",
        "dueDate": "end_date",
        "impact": "priority",
        "tags[]": "tag_ids[]"
      },
      "eligibility": ["kind is todo or daily", "lifecycleState is not archived"],
      "safety": ["Create/update is explicit unless autoCreateTasks is enabled.", "Completing or archiving a Quest never completes or deletes a Focus task."]
    },
    {
      "id": "toggl-focus-time-entry-to-quest-actual",
      "service": "toggl-focus",
      "direction": "import",
      "source": "focus.time_entry",
      "target": "quest.externalLinks[]",
      "mapping": {
        "id": "externalLinks[].externalId",
        "task_id": "externalLinks[].taskId",
        "duration": "externalLinks[].durationMinutes",
        "start": "externalLinks[].entryStartAt",
        "end": "externalLinks[].entryStopAt"
      },
      "safety": ["A Focus time entry can map to only one Quest.", "Direct Focus task matches may be confirmed in bulk; unlinked entries require a selected Quest.", "actualMinutes uses Focus totals before manualActualMinutes."]
    },
    {
      "id": "toggl-time-entry-to-focus-log",
      "service": "toggl-track",
      "direction": "import",
      "source": "toggl.time_entry",
      "target": "focusLog",
      "mapping": {
        "description": "title",
        "duration": "durationMinutes",
        "project_id": "tags[]",
        "tag_ids": "tags[]",
        "id": "externalLinks[].externalId"
      },
      "rewardFormula": {
        "xp": "round(durationMinutes / 2)",
        "gems": "max(1, round(durationMinutes / 15))",
        "bossDamage": "max(4, round(durationMinutes / 5))"
      }
    },
    {
      "id": "questforge-daily-summary-to-notion",
      "service": "notion",
      "direction": "export",
      "source": "questforge.daily_summary",
      "target": "notion.page",
      "mapping": {
        "date": "properties.Date",
        "completedQuests": "children.completed",
        "bossLog": "children.boss",
        "earnedGems": "properties.Gems"
      }
    }
  ],
  "conflictPolicy": {
    "default": "newest_updated_at_wins",
    "manualReviewWhen": [
      "bothSidesChangedTitle",
      "externalDeletedButQuestCompleted",
      "recurrenceChanged"
    ]
  }
}
