{
  "version": "1.0.0",
  "adapters": [
    {
      "id": "google-calendar",
      "name": "Google Calendar",
      "auth": "oauth2",
      "minimumScopes": [
        "https://www.googleapis.com/auth/calendar.events.readonly",
        "https://www.googleapis.com/auth/calendar.calendarlist.readonly"
      ],
      "capabilities": ["import", "convert_to_quest"],
      "resources": ["events", "calendars"],
      "recommendedMvp": "import"
    },
    {
      "id": "google-tasks",
      "name": "Google Tasks",
      "auth": "oauth2",
      "minimumScopes": [
        "https://www.googleapis.com/auth/tasks"
      ],
      "capabilities": ["import", "export", "bidirectional"],
      "resources": ["tasklists", "tasks"],
      "recommendedMvp": "bidirectional",
      "limitations": [
        "Google Tasks due dates discard time-of-day values through the API."
      ]
    },
    {
      "id": "toggl-focus",
      "name": "Toggl Focus",
      "auth": "personal_api_key",
      "minimumScopes": [],
      "capabilities": ["task_export", "timer_read", "timer_write", "time_entry_import", "estimate_insights"],
      "resources": ["organizations", "workspaces", "projects", "tags", "tasks", "time_entries"],
      "recommendedMvp": "manual_confirmation",
      "privacy": ["QuestForge stores only confirmed time entries, never desktop app names or window titles."],
      "limitations": ["Workspace discovery is entered by the user as numeric organization and workspace IDs.", "At most 30 days of entries are retrieved per request."]
    },
    {
      "id": "toggl-track",
      "name": "Toggl Track",
      "auth": "basic_api_token",
      "minimumScopes": [],
      "capabilities": ["import", "timer_read", "timer_write"],
      "resources": ["workspaces", "projects", "tags", "time_entries"],
      "recommendedMvp": "future_compatibility",
      "syncStrategy": "polling_modified_since"
    },
    {
      "id": "notion",
      "name": "Notion",
      "auth": "oauth2",
      "capabilities": ["export"],
      "resources": ["pages", "databases", "data_sources"],
      "recommendedMvp": "export"
    }
  ]
}
